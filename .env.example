# Salin file ini menjadi ".env" lalu isi dengan nilai yang sesuai.

# --- Database (Supabase Postgres + pgvector) ---
DATABASE_URL=postgresql://postgres:[PASSWORD]@[SUPABASE_HOST]:5432/postgres

# --- Embedding ---
EMBEDDING_PROVIDER=bge-m3
EMBEDDING_DIM=1024

# Dipakai hanya jika EMBEDDING_PROVIDER=external
EXTERNAL_EMBEDDING_ENDPOINT=
EXTERNAL_EMBEDDING_API_KEY=

# --- LLM (Groq) ---
GROQ_API_KEY=xxxxx

# --- Token untuk sumber API (Integrator) ---
EOFFICE_TOKEN=
SIMPEG_TOKEN=
ARSIP_TOKEN=

# --- Sumber MySQL eksternal ---
MYSQL_SOURCE_HOST=
MYSQL_SOURCE_USER=
MYSQL_SOURCE_PASSWORD=
MYSQL_SOURCE_DB=
MYSQL_SOURCE_PORT=3306

# --- Django ---
DJANGO_SECRET_KEY=ubah-dengan-secret-key-acak
DJANGO_DEBUG=True
